# Локальные учебные реквизиты. make setup копирует файл только при отсутствии .env.
S3_ACCESS_KEY_ID=cifar-local
S3_SECRET_ACCESS_KEY=cifar-local-development-2026
S3_BUCKET=cifar10
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_INTERNAL_ENDPOINT_URL=http://s3:9000
S3_BIND_HOST=127.0.0.1
S3_API_PORT=9000
S3_CONSOLE_PORT=9001
S3_HEALTHCHECK_URL=http://127.0.0.1:9000/health
RUSTFS_ADDRESS=:9000
RUSTFS_CONSOLE_ADDRESS=:9001
AWS_REQUEST_CHECKSUM_CALCULATION=when_required
AWS_RESPONSE_CHECKSUM_VALIDATION=when_required
